  $('th-idx').textContent = asc ? 'orden' : 'turnover n°';
  $('tbody').innerHTML = filas.map((f,k)=>{
    const usado = f.i<=state.n;
    return `<tr class="${usado?'':'dim'}"><td>${asc?k+1:f.i}</td><td>${fmt(f.v)}</td></tr>`;
  }).join('');
  $('cap-tabla').textContent = state.n<600
    ? `Las filas atenuadas quedan fuera de los ${state.n} turnovers seleccionados.`
    : 'Los 600 turnovers de la serie.';
}

/* ---------- actualizar ---------- */
function actualizar(){
  const datos=ON_TIMES.slice(0,state.n);
  const s=stats(datos);
  pintarStats(s);
  $('v-n').textContent=state.n;
  $('v-w').textContent=state.w+' ms';
  $('v-l').textContent=state.lambda.toFixed(2)+' s⁻¹';
  const nb=Math.min(Math.ceil(Math.max(...datos)/state.w),400);
  $('h-bins').textContent=`${nb} intervalos`;
  $('h-modo').textContent= state.dens
    ? 'Cada barra vale conteo / (n × ancho). El área total es 1.'
    : 'Cada barra es el número de turnovers del intervalo. Para comparar con una densidad, cambia a Normalizado.';
  $('box-curva').hidden=!state.dens;
  $('h-l').textContent=`1/λ = ${fmt(1000/state.lambda)} ms · promedio de los datos = ${fmt(s.mean)} ms`;
  $('box-lambda').hidden=!state.curva;
  dibujarHist(); pintarTabla();
}

/* ---------- eventos ---------- */
$('s-n').addEventListener('input',e=>{state.n=+e.target.value; actualizar();});
$('s-w').addEventListener('input',e=>{state.w=+e.target.value; actualizar();});
$('s-l').addEventListener('input',e=>{state.lambda=+e.target.value; actualizar();});
$('c-exp').addEventListener('change',e=>{state.curva=e.target.checked; actualizar();});

function par(a,b,campo,va,vb){
  $(a).addEventListener('click',()=>{state[campo]=va;$(a).setAttribute('aria-pressed','true');$(b).setAttribute('aria-pressed','false');actualizar();});
  $(b).addEventListener('click',()=>{state[campo]=vb;$(b).setAttribute('aria-pressed','true');$(a).setAttribute('aria-pressed','false');actualizar();});
}
par('b-frec','b-dens','dens',false,true);
par('b-orden','b-medida','orden','asc','medida');

function tab(sel){
  const hist=sel==='hist';
  $('tab-hist').setAttribute('aria-selected',hist);
  $('tab-datos').setAttribute('aria-selected',!hist);
  $('p-hist').hidden=!hist; $('p-datos').hidden=hist;
  if(hist){dibujarHist();}
}
$('tab-hist').addEventListener('click',()=>tab('hist'));
$('tab-datos').addEventListener('click',()=>tab('datos'));

let rt; window.addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(dibujarHist,120);});
actualizar();
</script>
</body>
</html>
