const $ = id => document.getElementById(id);
const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

let state = {n:600, w:60, dens:false, curva:false, lambda:6, orden:'asc'};

/* ---------- estadisticas ---------- */
function stats(a){
  const n=a.length, mean=a.reduce((s,v)=>s+v,0)/n;
  const varz=a.reduce((s,v)=>s+(v-mean)**2,0)/(n-1);
  return {n, min:Math.min(...a), max:Math.max(...a), mean, varz, sd:Math.sqrt(varz)};
}
const fmt=(x,d=1)=>x.toLocaleString('es-CL',{minimumFractionDigits:d,maximumFractionDigits:d,useGrouping:false});

function pintarStats(s){
  $('stats').innerHTML = [
    ['Mínimo', fmt(s.min), 'ms'],
    ['Máximo', fmt(s.max), 'ms'],
    ['Promedio', fmt(s.mean), 'ms'],
    ['Varianza', fmt(s.varz,0), 'ms²'],
    ['Desv. estándar', fmt(s.sd), 'ms'],
    ['Datos', String(s.n), '']
  ].map(([k,v,u])=>`<div class="stat"><dt>${k}</dt><dd>${v}<span>${u}</span></dd></div>`).join('');
}

/* ---------- canvas ---------- */
function setup(cv,alto){
  const dpr=Math.min(window.devicePixelRatio||1,2);
  const w=Math.max(cv.clientWidth,1), h=Math.round(alto);
  cv.style.height=h+'px';
  cv.width=Math.round(w*dpr); cv.height=Math.round(h*dpr);
  const ctx=cv.getContext('2d'); ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,w,h);
  return {ctx,w,h};
}
const altoHist=w=>Math.min(250,Math.max(170,w*0.46));

/* ---------- histograma ---------- */
let alturaPrevia=[], animId=null;

function binear(datos,w){
  const maxT=Math.max(...datos);
  const nb=Math.min(Math.ceil(maxT/w),400);
  const c=new Array(nb).fill(0);
  datos.forEach(v=>{ let k=Math.floor(v/w); if(k>=nb)k=nb-1; c[k]++; });
  return {c,nb,w,xmax:nb*w};
}

function dibujarHist(){
  const cv=$('hist'); if(!cv.clientWidth) return;
  const datos=ON_TIMES.slice(0,state.n);
  const {c,nb,w:bw,xmax}=binear(datos,state.w);
  const n=datos.length;

  const alturas=c.map(v=> state.dens ? v/(n*bw) : v);

  const lam=state.lambda/1000;                      // 1/ms
  const fdens=t=>lam*Math.exp(-lam*t);
  const verCurva=state.curva && state.dens;         // solo tiene sentido normalizado

  let ymax=Math.max(...alturas)*1.1;      // fijado por los datos, no por lambda

  if(alturaPrevia.length!==nb) alturaPrevia=new Array(nb).fill(0);
  const desde=alturaPrevia.slice();
  const t0=performance.now(), dur=reduce?0:230;

  cancelAnimationFrame(animId);
  const paso=ahora=>{
    const p=dur? Math.min((ahora-t0)/dur,1) : 1;
    const e=1-Math.pow(1-p,3);
    render(desde.map((v,i)=>v+(alturas[i]-v)*e));
    if(p<1) animId=requestAnimationFrame(paso); else alturaPrevia=alturas;
  };
  animId=requestAnimationFrame(paso);

  function render(hs){
    const {ctx,w,h}=setup(cv,altoHist(cv.clientWidth));
    const ml=44, mr=24, mt=10, mb=30;
    const pw=w-ml-mr, ph=h-mt-mb;
    const X=t=>ml+(t/xmax)*pw;
    const Y=v=>mt+ph-(v/ymax)*ph;

    ctx.font='11px "IBM Plex Mono",monospace';
    ctx.fillStyle='#667069';

    // marcas verticales
    ctx.textAlign='right'; ctx.textBaseline='middle';
    for(let k=0;k<=4;k++){
      const v=ymax*k/4, y=Y(v);
      ctx.strokeStyle= k?'#EDF0EA':'#16211C'; ctx.lineWidth=1;
      ctx.beginPath(); ctx.moveTo(ml,y); ctx.lineTo(ml+pw,y); ctx.stroke();
      const et= state.dens ? v.toFixed(4).replace('0.',',') : Math.round(v);
      ctx.fillText(et, ml-7, y);
    }

    // barras
    ctx.strokeStyle='#7B8730'; ctx.lineWidth=1;
    hs.forEach((v,i)=>{
      if(v<=0) return;
      const x=X(i*bw), y=Y(v), bwPx=Math.max(pw/nb,1);
      ctx.fillStyle='rgba(220,228,92,.9)';
      ctx.fillRect(x,y,bwPx,mt+ph-y);
      if(bwPx>2.5) ctx.strokeRect(x+.5,y+.5,bwPx-1,mt+ph-y-1);
    });

    // curva
    if(verCurva){
      ctx.save();
      ctx.beginPath(); ctx.rect(ml,mt,pw,ph); ctx.clip();
      ctx.strokeStyle='#C2405A'; ctx.lineWidth=2.2;
      ctx.beginPath();
      for(let px=0;px<=pw;px++){
        const t=(px/pw)*xmax, y=Y(fdens(t));
        px?ctx.lineTo(ml+px,y):ctx.moveTo(ml+px,y);
      }
      ctx.stroke();
      ctx.restore();
    }

    // eje x
    ctx.strokeStyle='#16211C'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(ml,mt+ph); ctx.lineTo(ml+pw,mt+ph); ctx.stroke();
    ctx.textAlign='center'; ctx.textBaseline='top'; ctx.fillStyle='#667069';
    for(let k=0;k<=4;k++){
      const t=xmax*k/4;
      ctx.fillText(Math.round(t), X(t), mt+ph+7);
    }
    ctx.fillText('On-time (ms)', ml+pw/2, mt+ph+20);
  }
}

/* ---------- tabla ---------- */
